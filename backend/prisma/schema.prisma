// Prisma Schema - データベースの構造を定義するファイル
// これを元にPrismaがDBテーブルとTypeScriptの型を自動生成する

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ローカル: sqlite, 本番(Railway): postgresql
  // 環境変数 DATABASE_URL の形式で自動判別
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Todoテーブルの定義
model Todo {
  id        Int      @id @default(autoincrement()) // 自動採番のID
  title     String                                  // タイトル（必須）
  completed Boolean  @default(false)               // 完了フラグ（デフォルトfalse）
  createdAt DateTime @default(now())               // 作成日時（自動設定）
  updatedAt DateTime @updatedAt                    // 更新日時（自動更新）
}

// 個人情報（フォーム送信）テーブル
model Contact {
  id        Int      @id @default(autoincrement())
  sessionId String?                                 // チャットセッションID（任意）
  name      String                                  // 名前（必須）
  email     String                                  // メールアドレス（必須）
  phone     String?                                 // 電話番号（任意）
  message   String?                                 // メッセージ（任意）
  createdAt DateTime @default(now())
}

// チャットセッションテーブル
model ChatSession {
  id        String   @id @default(uuid())           // セッションID（UUID）
  mode      String   @default("normal")             // モード（normal/mentor）
  messages  ChatMessage[]                           // メッセージ一覧（1対多）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// チャットメッセージテーブル
model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId String                                  // セッションID
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String                                  // user / assistant
  content   String                                  // メッセージ内容
  createdAt DateTime    @default(now())
}
