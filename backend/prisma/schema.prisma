// Prisma Schema - データベースの構造を定義するファイル
// これを元にPrismaがDBテーブルとTypeScriptの型を自動生成する

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // ローカル: sqlite, 本番(Railway): postgresql
  // 環境変数 DATABASE_URL の形式で自動判別
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Todoテーブルの定義
model Todo {
  id        Int      @id @default(autoincrement()) // 自動採番のID
  title     String                                  // タイトル（必須）
  completed Boolean  @default(false)               // 完了フラグ（デフォルトfalse）
  createdAt DateTime @default(now())               // 作成日時（自動設定）
  updatedAt DateTime @updatedAt                    // 更新日時（自動更新）
}
